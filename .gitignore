# Compiled files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Variable files & secrets (may contain sensitive data)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.sample
*service-account*.json
*credentials*.json

# Crash logs & general logs
*.log
crash.log
crash.*.log

# Directories
.terraform/

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# SSH Keys
*.pem

# Backup files
*.bak

# Ignored Terraform files
*gitignore*.tf

# Ignore Mac .DS_Store files
.DS_Store

# Ignored vscode files
.vscode/
